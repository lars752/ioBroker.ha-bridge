{
  "type": "tabs",
  "i18n": false,
  "items": {
    "mqtt": {
      "type": "panel",
      "label": { "de": "MQTT-Broker", "en": "MQTT Broker" },
      "items": {
        "_mqttHint": {
          "type": "staticText",
          "text": {
            "de": "Verbindungseinstellungen zum MQTT-Broker. Derselbe Broker muss in Home Assistant unter Einstellungen → Integrationen → MQTT konfiguriert sein.",
            "en": "Connection settings for the MQTT broker. The same broker must be configured in Home Assistant under Settings → Integrations → MQTT."
          },
          "newLine": true,
          "sm": 12
        },
        "mqttHost": {
          "type": "text",
          "label": { "de": "Broker-Adresse", "en": "Broker host" },
          "help": { "de": "Hostname oder IP, z. B. 192.168.1.10 oder localhost", "en": "Hostname or IP, e.g. 192.168.1.10 or localhost" },
          "newLine": true,
          "sm": 12,
          "md": 5
        },
        "mqttPort": {
          "type": "number",
          "label": { "de": "Port", "en": "Port" },
          "min": 1,
          "max": 65535,
          "sm": 12,
          "md": 2
        },
        "mqttUseTls": {
          "type": "checkbox",
          "label": { "de": "TLS / MQTTS", "en": "TLS / MQTTS" },
          "sm": 12,
          "md": 2
        },
        "mqttUsername": {
          "type": "text",
          "label": { "de": "Benutzername", "en": "Username" },
          "newLine": true,
          "sm": 12,
          "md": 4
        },
        "mqttPassword": {
          "type": "password",
          "label": { "de": "Passwort (verschlüsselt gespeichert)", "en": "Password (stored encrypted)" },
          "sm": 12,
          "md": 4
        }
      }
    },
    "ha": {
      "type": "panel",
      "label": { "de": "Home Assistant", "en": "Home Assistant" },
      "items": {
        "_haHint": {
          "type": "staticText",
          "text": {
            "de": "MQTT Discovery Prefix muss mit der Einstellung in HA übereinstimmen (Standard: homeassistant). State Topic Prefix ist ein frei wählbarer Namensraum für die Zustandsthemen.",
            "en": "MQTT Discovery Prefix must match the HA setting (default: homeassistant). State Topic Prefix is a freely chosen namespace for the state topics."
          },
          "newLine": true,
          "sm": 12
        },
        "discoveryPrefix": {
          "type": "text",
          "label": { "de": "MQTT Discovery Prefix", "en": "MQTT Discovery Prefix" },
          "help": { "de": "Standard: homeassistant", "en": "Default: homeassistant" },
          "newLine": true,
          "sm": 12,
          "md": 4
        },
        "haStateTopic": {
          "type": "text",
          "label": { "de": "State Topic Prefix", "en": "State Topic Prefix" },
          "help": { "de": "z. B. iob2ha – Datenpunkte landen unter iob2ha/shelly-gruppen/…", "en": "e.g. iob2ha – data points go to iob2ha/shelly-gruppen/…" },
          "sm": 12,
          "md": 4
        },
        "retainDiscovery": {
          "type": "checkbox",
          "label": { "de": "Discovery-Nachrichten mit Retain senden", "en": "Send discovery messages with retain" },
          "help": { "de": "Empfohlen: HA findet Entitäten auch nach einem HA-Neustart sofort.", "en": "Recommended: HA finds entities immediately after a HA restart." },
          "newLine": true,
          "sm": 12,
          "md": 4
        },
        "publishIntervalSec": {
          "type": "number",
          "label": { "de": "Heartbeat-Intervall (Sekunden)", "en": "Heartbeat interval (seconds)" },
          "help": { "de": "Alle N Sekunden werden alle bekannten Werte erneut gesendet. 0 = nie.", "en": "Every N seconds all known values are republished. 0 = never." },
          "min": 0,
          "max": 3600,
          "sm": 12,
          "md": 4
        }
      }
    },
    "sources": {
      "type": "panel",
      "label": { "de": "Quell-Adapter & Gruppen", "en": "Source adapters & groups" },
      "items": {
        "_srcHint": {
          "type": "staticText",
          "text": {
            "de": "1. Quell-Instanzen eintragen. 2. „Gruppen einlesen" klicken – der Adapter ermittelt alle verfügbaren Gruppen. 3. Häkchen setzen, welche Gruppen zu Home Assistant übertragen werden sollen. Deaktivierte Gruppen werden komplett ignoriert.",
            "en": "1. Enter source instances. 2. Click „Read groups" – the adapter fetches all available groups. 3. Check which groups should be sent to Home Assistant. Disabled groups are completely ignored."
          },
          "newLine": true,
          "sm": 12
        },
        "sources": {
          "type": "table",
          "label": { "de": "Quell-Instanzen", "en": "Source instances" },
          "newLine": true,
          "sm": 12,
          "items": [
            {
              "attr": "enabled",
              "type": "checkbox",
              "title": { "de": "Aktiv", "en": "Enabled" },
              "width": "80px"
            },
            {
              "attr": "adapter",
              "type": "instance",
              "title": { "de": "Instanz", "en": "Instance" },
              "allowAnyInstance": true,
              "width": "100%"
            }
          ],
          "buttons": ["add", "delete"]
        },
        "_discoverBtn": {
          "type": "sendTo",
          "command": "discoverGroups",
          "jsonData": "{\"config\": ${JSON.stringify(data)}}",
          "useNative": true,
          "variant": "outlined",
          "label": {
            "de": "Gruppen der Quell-Instanzen einlesen",
            "en": "Read groups of source instances"
          },
          "tooltip": {
            "de": "Ergänzt die Gruppen-Tabelle um alle gefundenen Gruppen (bestehende Häkchen bleiben erhalten). Die Instanz muss laufen.",
            "en": "Adds all found groups to the group table (existing checkmarks are kept). The instance must be running."
          },
          "newLine": true,
          "sm": 12,
          "md": 6,
          "result": "groups"
        },
        "groups": {
          "type": "table",
          "label": { "de": "Gruppen (Auswahl für HA)", "en": "Groups (selection for HA)" },
          "newLine": true,
          "sm": 12,
          "items": [
            {
              "attr": "enabled",
              "type": "checkbox",
              "title": { "de": "Übertragen", "en": "Send to HA" },
              "width": "110px"
            },
            {
              "attr": "adapter",
              "type": "text",
              "title": { "de": "Instanz", "en": "Instance" },
              "width": "40%",
              "readOnly": true
            },
            {
              "attr": "group",
              "type": "text",
              "title": { "de": "Gruppe", "en": "Group" },
              "width": "60%",
              "readOnly": true
            }
          ],
          "buttons": ["delete"]
        }
      }
    }
  }
}
